# Vorlage: Werte ausfüllen, dann als .env speichern.
# Ausführliche Erklärungen zu jedem Feld: siehe .env.example.read
APP_BASE_URL="http://localhost:3010"

# Secrets — vor dem Deploy setzen (leer = App startet nicht).
# AUTH_SECRET:   openssl rand -base64 48   (mind. 32 Zeichen)
# ENCRYPTION_KEY: openssl rand -hex 32     (genau 64 Hex-Zeichen)
AUTH_SECRET=""
ENCRYPTION_KEY=""

# SSO / OIDC — aus der Client-Registrierung
OIDC_ISSUER="http://localhost:3000"                       # Browser-seitig (authorize/logout)
OIDC_INTERNAL_ISSUER="http://host.docker.internal:3000"   # Server-seitig AUS dem Container (token/jwks/userinfo)
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
ADMIN_USER="admin"

# Datenbank (PostgreSQL) — Passwort für Produktion ändern
DATABASE_URL="postgres://gremio:gremio@localhost:5432/gremio"
POSTGRES_PASSWORD="gremio"

UPLOAD_DIR="./uploads"
# Hinter Reverse-Proxy (nginx terminiert SSL) auf true setzen
AUTH_TRUST_HOST="false"
